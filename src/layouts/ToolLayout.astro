---
import BaseLayout from './BaseLayout.astro';
import { getSiteConfig } from '../utils/contentLoader';
import { getRelatedTools, getPostsForTool } from '../utils/related';
import RelatedTools from '../components/RelatedTools.astro';
import RelatedReading from '../components/RelatedReading.astro';
import '../styles/tools.scss';

interface Faq {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  toolName: string;
  keywords?: string;
  faqs?: Faq[];
  /** A concise, user-visible inventory of the actions available in the workspace. */
  features?: string[];
  /** Editor-style tools use the viewport as their working canvas. */
  workbench?: boolean;
  /** Keep only semantic page identity when an app workspace needs every visible pixel. */
  minimalHeader?: boolean;
}

const config = getSiteConfig();
// Tool pages are applications first. Their title remains semantic for search and
// assistive technology, while the visible viewport is reserved for the tool.
const { title, description, toolName, keywords = '', faqs = [], features = [], workbench = false, minimalHeader = true } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const hasAbout = Astro.slots.has('about');

const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const relatedTools = getRelatedTools(currentPath, 4);
const relatedPosts = getPostsForTool({ name: toolName, desc: description }, 3);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: toolName, href: currentPath || '/tools' },
];

const toolJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: toolName,
  description: description,
  url: canonicalURL.href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: config.site.title, url: config.site.url },
  browserRequirements: 'Requires JavaScript',
  ...(features.length ? { featureList: features } : {}),
};

const faqJsonLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={`${toolName} - Free Online Tool | DailyCoder`} description={description} breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <meta name="keywords" content={`${toolName}, ${keywords}, free online tool, developer tool, no signup, client-side`} />
    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify(toolJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <div class:list={['tool-page', 'tool-page--workspace', { 'tool-page--workbench': workbench, 'tool-page--minimal-header': minimalHeader }]}>
    <div class="tool-container">
      {minimalHeader ? (
        <h1 class="tool-title--sr-only" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">{toolName}</h1>
      ) : (
        <header class="tool-intro">
          <a class="tool-back" href="/tools" aria-label="Back to all tools">← <span>All tools</span></a>
          <div class="tool-intro__identity">
            <h1>{toolName}</h1>
            <p>{description}</p>
          </div>
          <span class="tool-privacy">Private · browser only</span>
        </header>
      )}
      <slot />

      {(hasAbout || faqs.length > 0 || relatedTools.length > 0) && (
        <section class="tool-guide" aria-label={`Guide and FAQs for ${toolName}`}>
          {hasAbout && (
            <details class="acc acc--about">
              <summary class="acc__head">
                <svg class="acc__lead" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span class="acc__q">About {toolName}</span>
                <svg class="acc__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="acc__panel">
                <div class="acc__panel-inner">
                  <slot name="about" />
                </div>
              </div>
            </details>
          )}

          {faqs.length > 0 && (
            <div class="tool-guide__faq">
              <h2 class="tool-guide__heading">Frequently asked questions</h2>
              <div class="acc-group" data-acc-group>
                {faqs.map((f) => (
                  <details class="acc">
                    <summary class="acc__head">
                      <span class="acc__q">{f.q}</span>
                      <svg class="acc__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="acc__panel">
                      <div class="acc__panel-inner">
                        <p>{f.a}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}

          <RelatedTools tools={relatedTools} />
          <RelatedReading posts={relatedPosts} heading="From the blog" />
        </section>
      )}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-acc-group]').forEach(function (group) {
      var items = group.querySelectorAll('details.acc');
      items.forEach(function (d) {
        d.addEventListener('toggle', function () {
          if (!d.open) return;
          items.forEach(function (other) {
            if (other !== d) other.open = false;
          });
        });
      });
    });
  </script>
</BaseLayout>

<style is:global>
  .tool-page { padding: 0; }
  .tool-container {
    max-width: var(--tool-max-width, 100%);
    margin: 0 auto;
    padding: 0.65rem 1.5rem 1rem;
  }
  /* The tool is the page's product. Keep its identity available without
     placing a marketing hero between the visitor and the workspace. */
  .tool-page--workspace .tool-intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 46px;
    margin: 0 0 0.75rem;
    padding: 0 0 0.65rem;
    border-bottom: 1px solid var(--color-border);
  }
  .tool-page--workspace .tool-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 32px;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--color-text-light);
  }
  .tool-intro__identity { min-width: 0; }
  .tool-page--workspace .tool-intro h1 {
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    letter-spacing: -0.02em;
  }
  .tool-page--workspace .tool-intro p {
    overflow: hidden;
    max-width: none;
    margin: 0.1rem 0 0;
    color: var(--color-text-light);
    font-size: 0.73rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tool-page--workspace .tool-privacy {
    white-space: nowrap;
    padding: 0.25rem 0.48rem;
    border-radius: 999px;
    color: var(--dc-sage-ink);
    background: var(--dc-sage);
    font-size: 0.68rem;
    font-weight: 650;
  }
  .tool-title--sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tool-page--workbench .tool-panels {
    min-height: max(480px, calc(100dvh - var(--site-header-height) - 168px));
    align-items: stretch;
  }
  .tool-page--workbench .tool-panels > .tool-panel { min-height: 0; height: 100%; }
  .tool-page--workbench .tool-panels .tool-textarea,
  .tool-page--workbench .tool-panels .dc-editor,
  .tool-page--workbench .tool-panels .tool-output {
    flex: 1;
    min-height: 0;
  }
  .tool-page--workbench .tool-panels .tool-textarea { height: 100%; resize: none; }
  .tool-page--workbench .tool-panels .tool-output { height: 100%; margin: 0; }
  .tool-page--workbench .tool-panels .dc-editor,
  .tool-page--workbench .tool-panels .dc-editor .dc-editor__mount,
  .tool-page--workbench .tool-panels .dc-editor .cm-editor,
  .tool-page--workbench .tool-panels .dc-editor .cm-scroller { height: 100%; }
  /* Workspace controls are toolbar controls, not marketing CTAs. */
  .tool-page--workspace .tool-btn {
    min-height: 32px;
    padding: 0.34rem 0.62rem;
    border-radius: var(--radius-sm);
    font-size: 0.76rem;
  }
  .tool-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
  }
  .tool-panel__head .tool-panel__label { padding-right: 0; }
  .workspace-actions,
  .tab-bar__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tab-bar__actions { margin-left: auto; }
  /* ── Tool guide: About + FAQ accordion (separated from the tool) ── */
  .tool-guide {
    margin: 3rem auto 0.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .tool-guide__heading {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 1.75rem 0 0.85rem;
  }
  .acc {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    margin-bottom: 0.55rem;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .acc:hover {
    border-color: color-mix(in oklab, var(--color-primary) 28%, var(--color-border));
  }
  .acc[open] {
    border-color: color-mix(in oklab, var(--color-primary) 42%, var(--color-border));
    box-shadow: var(--shadow-sm);
  }
  .acc__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.05rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-text);
  }
  .acc__head::-webkit-details-marker { display: none; }
  .acc__head:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }
  .acc__q { flex: 1; min-width: 0; }
  .acc__lead {
    width: 18px; height: 18px;
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .acc__chev {
    width: 18px; height: 18px;
    color: var(--color-text-light);
    flex-shrink: 0;
    transition: transform 220ms ease;
  }
  .acc[open] .acc__chev { transform: rotate(180deg); }
  .acc__panel-inner {
    padding: 0 1.05rem 1.05rem;
    animation: accReveal 240ms ease;
  }
  .acc--about .acc__panel-inner { padding-bottom: 1.25rem; }
  .acc__panel-inner > p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin: 0;
  }
  @keyframes accReveal {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }

  /* About content is slotted by each tool; it now lives inside the accordion */
  .tool-about { margin: 0; padding: 0; border: 0; }
  .tool-about > :first-child { margin-top: 0; }
  .tool-about h2 {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
  }
  .tool-about h3 {
    font-size: 0.95rem;
    margin: 1.1rem 0 0.4rem;
  }
  .tool-about p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin-bottom: 0.7rem;
  }
  .tool-about ul {
    margin: 0.4rem 0 0.9rem 1.2rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-light);
  }
  .tool-about li { margin-bottom: 0.3rem; }
  .tool-about code {
    font-size: 0.82rem;
    background: var(--color-code-bg);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }
  .tool-about a { color: var(--color-primary); }

  @media (prefers-reduced-motion: reduce) {
    .acc__panel-inner { animation: none; }
    .acc__chev { transition: none; }
  }
  @media (max-width: 768px) {
    .tool-container { padding: 0.5rem 1rem 0.75rem; }
    .tool-page--workspace .tool-intro { gap: 0.5rem; min-height: 38px; margin-bottom: 0.6rem; padding-bottom: 0.55rem; }
    .tool-page--workspace .tool-back span, .tool-page--workspace .tool-privacy { display: none; }
    .tool-page--workspace .tool-intro p { font-size: 0.68rem; }
    .tool-page--workbench .tool-panels { min-height: 0; }
    .tool-guide { margin-top: 2.25rem; }
  }
</style>

<style is:global>
  .tool-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .tool-panel { display: flex; flex-direction: column; gap: 0.4rem; }
  .tool-panel__label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-light); }
  .tool-textarea { width: 100%; min-height: 250px; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); font-family: var(--font-mono); font-size: 0.8rem; resize: vertical; line-height: 1.5; }
  .tool-textarea:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 18%, transparent); }
  .tool-input { width: 100%; padding: 0.6rem 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); font-family: var(--font-mono); font-size: 0.85rem; }
  select.tool-input { padding-right: 2.35rem; cursor: pointer; }
  select.tool-input option, select.tool-input optgroup { background: var(--color-surface); color: var(--color-text); }
  .tool-input:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .tool-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.55rem 0; }
  .tool-btn { padding: 0.5rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 150ms ease; }
  .tool-btn:hover { border-color: var(--color-primary); background: var(--color-code-bg); }
  .tool-btn--primary { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
  .tool-btn--primary:hover { background: var(--color-primary-dark); }
  .tool-output { width: 100%; min-height: 250px; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-code-bg); color: var(--color-text); font-family: var(--font-mono); font-size: 0.8rem; overflow: auto; line-height: 1.5; white-space: pre-wrap; word-break: break-all; }
  .tool-error { color: var(--color-danger); font-size: 0.85rem; font-weight: 600; margin-top: 0.5rem; }
  .tool-success { color: var(--color-success); font-size: 0.85rem; font-weight: 600; margin-top: 0.5rem; }
  @media (max-width: 768px) { .tool-panels { grid-template-columns: 1fr; } .tool-textarea, .tool-output { min-height: 180px; } }
</style>
