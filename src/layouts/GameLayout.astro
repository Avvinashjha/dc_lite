---
import ArcadeLayout from './ArcadeLayout.astro';
import {games} from '../games/catalog.mjs';
interface Props { game: (typeof games)[number]; }
const {game} = Astro.props;
const url = new URL(`/games/${game.slug}/`, Astro.site).href;
const related = games.filter(g => g.slug !== game.slug && g.category === game.category).slice(0, 3);
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'VideoGame', '@id':url, name:game.name, description:game.description, url, image:new URL(`/games/art/${game.slug}-share.png`, Astro.site).href, genre:game.category, gamePlatform:'Web browser', applicationCategory:'GameApplication', operatingSystem:'Any modern web browser', playMode:'SinglePlayer', inLanguage:'en', isAccessibleForFree:true, offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}, publisher:{'@type':'Organization',name:'DailyCoder',url:Astro.site?.href}},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'DailyCoder',item:Astro.site?.href},{'@type':'ListItem',position:2,name:'Games',item:new URL('/games/',Astro.site).href},{'@type':'ListItem',position:3,name:game.name,item:url}]}
]};
---
<ArcadeLayout title={`${game.name} — Play Free Online | DailyCoder`} description={game.description} image={`/games/art/${game.slug}-share.png`} schema={schema}>
  <div class="arc-game-page" data-game-root data-slug={game.slug} data-title={game.name} data-accent={game.accent}>
    <nav class="arc-breadcrumb" aria-label="Breadcrumb"><a href="/games">← All games</a><span aria-hidden="true">/</span><span>{game.category}</span></nav>
    <div class="arc-game-heading"><div><p class="arc-eyebrow">YOUR NEXT LITTLE BREAK</p><h1>{game.name}</h1><p>{game.blurb}</p></div><button class="arc-button arc-favorite-page" data-favorite={game.slug} data-favorite-name={game.name} aria-pressed="false" aria-label={`Favorite ${game.name}`}>♡ Favorite</button></div>
    <div class="arc-play-grid">
      <section class="arc-machine" aria-label={`${game.name} game`}>
        <div class="arc-machine__bar"><span><i aria-hidden="true"></i><span data-game-status>Ready when you are</span></span><div><a href="/games/" class="arc-dashboard-link" aria-label="Back to games dashboard">← Games</a><button type="button" data-pause disabled aria-label="Pause game">Pause</button><button type="button" data-restart disabled aria-label="Restart game">Restart</button><button type="button" data-sound aria-pressed="false" aria-label="Enable game sound">Sound off</button><button type="button" data-fullscreen aria-expanded="false" aria-label="Expand game">⛶</button><button type="button" class="arc-fullscreen-close" data-fullscreen-close aria-label="Exit fullscreen">✕</button></div></div>
        <div class="arc-stage" data-stage>
          <div class="arc-poster" data-poster><img src={`/games/art/${game.slug}.svg`} width="1200" height="720" alt="" fetchpriority="high"/><div class="arc-poster__panel"><span class="arc-eyebrow">TAKE A MOMENT. MAKE A MOVE.</span><h2>{game.name}</h2><button class="arc-button arc-button--primary" type="button" data-play>Play now <span aria-hidden="true">↗</span></button><p data-load-message aria-live="polite">Free to play. No sign-in.</p></div></div>
          <div data-game-mount class="arc-mount" hidden></div>
          <div class="arc-pause-overlay" data-pause-overlay hidden><span class="arc-eyebrow">TAKE YOUR TIME</span><h2>A little pause.</h2><button class="arc-button arc-button--primary" data-resume>Back to the game</button></div>
        </div>
        <p class="arc-live sr-only" data-announcement role="status" aria-live="polite" aria-atomic="true"></p>
        <noscript><p class="arc-noscript">Enable JavaScript to play. You can read the rules and browse all games without it.</p></noscript>
      </section>
      <aside class="arc-field-notes"><span class="arc-eyebrow">THE SHORT VERSION</span><h2>Make yourself<br/>a little time.</h2><div class="arc-note"><span>01 / THE CONTROLS</span><p>{game.controls}</p></div><div class="arc-note"><span>02 / A FRIENDLY TIP</span><p>{game.tip}</p></div><div class="arc-note arc-note--quiet"><span>ALL YOURS</span><p>Your bests stay on this device. Sound is optional. Pause whenever you like.</p></div></aside>
    </div>
    <section class="arc-rules"><div><span class="arc-eyebrow">A GOOD PLACE TO START</span><h2>How to play {game.name}</h2></div><ol>{game.rules.map(rule=><li>{rule}</li>)}</ol></section>
    {related.length>0 && <section class="arc-related"><div class="arc-section-title"><h2>Another kind of break</h2><a href="/games">Explore all games ↗</a></div><div class="arc-card-grid arc-card-grid--related">{related.map(g=><a class="arc-card" href={`/games/${g.slug}`}><div class="arc-card__art"><img src={`/games/art/${g.slug}.svg`} width="1200" height="720" alt="" loading="lazy" decoding="async"/></div><div class="arc-card__body"><span class="arc-eyebrow">{g.category}</span><h3>{g.name}<span aria-hidden="true">↗</span></h3><p>{g.blurb}</p></div></a>)}</div></section>}
  </div>
  <script>import '../games/launch.js';</script>
</ArcadeLayout>
