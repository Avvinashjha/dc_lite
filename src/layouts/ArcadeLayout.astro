---
import '../styles/global.scss';
import '../styles/arcade.scss';
import ThemeInit from '../components/ThemeInit.astro';
import Logo from '../components/Logo.astro';
interface Props { title: string; description: string; image?: string; schema?: Record<string, unknown>; }
const {title, description, image = '/games/art/cricket-share.png', schema} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const social = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical}/><meta name="robots" content="index, follow"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <meta name="theme-color" content="#f8f9f5"/>
    <meta property="og:type" content="website"/><meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content={social}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content={`${title} — DailyCoder Games`}/><meta property="og:site_name" content="DailyCoder"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/><meta name="twitter:image" content={social}/>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <ThemeInit/>
  </head>
  <body class="arcade">
    <a class="arc-skip" href="#main">Skip to content</a>
    <header class="arc-header"><div class="arc-container arc-header__inner">
      <a class="arc-logo" href="/" aria-label="DailyCoder home"><span><Logo size={23} color="currentColor"/></span>DailyCoder<span class="arc-logo__divider" aria-hidden="true">/</span><span class="arc-logo__play">play</span></a>
      <nav aria-label="Main navigation"><a href="/">Learn</a><a href="/games" aria-current="page">Games</a><button type="button" data-theme-toggle aria-label="Toggle colour theme"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button></nav>
    </div></header>
    <main id="main" class="arc-container" tabindex="-1"><slot/></main>
    <footer class="arc-footer arc-container"><a href="/">A DailyCoder intermission.</a><p>A little play goes a long way.</p><nav aria-label="Footer"><a href="/privacy">Privacy</a><a href="/about">About</a><a href="/contact">Feedback</a></nav></footer>
    <script>
      import '../games/shell.js';
    </script>
  </body>
</html>
