---
import '../styles/global.scss';
import '../styles/components.scss';
import '../styles/site.scss';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeInit from '../components/ThemeInit.astro';
import '../styles/problems.scss';
import '../styles/problem-workspace.scss';
import Logo from '../components/Logo.astro';
import Icons from '../components/Icons.astro';
import LoginModal from '../components/LoginModal';
import { getSiteConfig } from '../utils/contentLoader';
import { ogImageForPath } from '../utils/og';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: { label: string; href: string }[];
  tags?: string[];
}

const config = getSiteConfig();
const syncConfig = (config as any).sync || {};
const syncScriptUrl = syncConfig.enabled ? (syncConfig.googleScriptUrl || '') : '';
const { title, description, breadcrumbs = [], tags = [] } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImageForPath(Astro.url.pathname), Astro.site).href;
const seo = (config as any).seo || {};
const analytics = (config as any).analytics || {};
const twitterHandle = seo.twitterHandle || '@dailycoder_in';
const locale = seo.locale || 'en_US';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f8f9f5" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Feed discovery -->
    <link rel="alternate" type="application/rss+xml" title={`${config.site.title} Blog`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${config.site.title} Daily Problems`} href="/daily/problem/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.label,
          item: new URL(crumb.href, Astro.site).href,
        })),
      })} />
    )}

    <slot name="head" />

    {analytics.googleSearchConsoleVerification && (
      <meta name="google-site-verification" content={analytics.googleSearchConsoleVerification} />
    )}
    {analytics.bingVerification && (
      <meta name="msvalidate.01" content={analytics.bingVerification} />
    )}
    {analytics.googleAnalyticsId && (
      <script is:inline define:vars={{gaId: analytics.googleAnalyticsId}}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        (function deferGA() {
          if (typeof requestIdleCallback !== 'undefined') {
            requestIdleCallback(loadGA, { timeout: 3500 });
          } else {
            setTimeout(loadGA, 2000);
          }
        })();
        function loadGA() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', gaId);
        }
      </script>
    )}

    <ThemeInit />
  </head>
  <body class="dc-site dc-editor-page">
    <a class="dc-skip" href="#main-content">Skip to problem</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>



    <LoginModal client:idle />
    <script src="/js/auth-gate.js" is:inline></script>
    <script src="/js/sync.js" is:inline></script>
    <script is:inline define:vars={{ syncScriptUrl }}>
      window.__dcSyncScriptUrl = syncScriptUrl || '';
    </script>
    <script src="/js/analytics.js" is:inline></script>
    <script src="/js/sync-init.js" is:inline></script>
    <script src="/js/base-ui.js" is:inline></script>
  </body>
</html>
