---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/school/SchoolIcon';
import Subscribe from '../components/Subscribe.astro';
import { getBlogPostsSorted, getCourses, getTodaysProblem, getPastDailyProblems, getDailyScheduleFullLite, getProblems } from '../utils/contentLoader';
import { ALL_TOOLS, TOOLS_COUNT } from '../data/tools';
import { calculateReadingTime } from '../utils/readingTime';
import '../styles/home.scss';

const posts = getBlogPostsSorted().slice(0, 3);
const courses = getCourses();
const problems = getProblems();
const today = getTodaysProblem();
const recent = getPastDailyProblems();
const featured = (today && problems.find(p => p.slug === today.slug))
  || problems.find(p => p.slug === recent[0]?.slug)
  || problems.find(p => p.difficulty.toLowerCase() === 'easy') || problems[0];
const isDaily = !!today && featured?.slug === today.slug;
const scheduleFullLite = getDailyScheduleFullLite();
const challengeHref = featured ? `/problems/${featured.slug}` : '/problems';
const tools = ['json-formatter', 'regex-tester', 'diff-checker', 'markdown-preview'].map(slug => ALL_TOOLS.find(t => t.href === `/tools/${slug}`)).filter(Boolean);
const destinations = [
  { label: 'Overview', href: '/', icon: 'home' },
  { label: 'Practice', href: '/problems', icon: 'code' },
  { label: 'Courses', href: '/courses', icon: 'book' },
  { label: 'Quizzes', href: '/quiz', icon: 'check' },
  { label: 'Developer tools', href: '/tools', icon: 'bolt' },
  { label: 'Articles', href: '/blog', icon: 'chat' },
  { label: 'Play & unwind', href: '/games', icon: 'play' },
];
const paths = [
  { title: 'Practice', desc: `${problems.length} coding problems`, href: '/problems', icon: 'code', tone: 'sage' },
  { title: 'Learn', desc: `${courses.length} hands-on courses`, href: '/courses', icon: 'book', tone: 'peach' },
  { title: 'Test yourself', desc: 'Quizzes for curious minds', href: '/quiz', icon: 'check', tone: 'lavender' },
  { title: 'Build', desc: `${TOOLS_COUNT} everyday dev tools`, href: '/tools', icon: 'bolt', tone: 'butter' },
  { title: 'Discover', desc: 'Ideas worth exploring', href: '/blog', icon: 'chat', tone: 'sky' },
  { title: 'Take a break', desc: 'A little play goes a long way', href: '/games', icon: 'play', tone: 'rose' },
];
---
<BaseLayout homeWorkspace title="DailyCoder — A little practice. A lot of possibility." description="Make room for a little learning. Practice coding, explore free developer tools, and build your skills with hands-on courses and quizzes.">
  <div class="dc-shell">
    <aside class="dc-sidebar" aria-label="Workspace navigation">
      <p class="dc-kicker">YOUR WORKSPACE</p>
      <nav aria-label="Explore DailyCoder">
        {destinations.map(item => <a href={item.href} class:list={{ 'is-current': item.href === '/' }} aria-current={item.href === '/' ? 'page' : undefined}><Icon name={item.icon} size={19}/><span>{item.label}</span>{item.href === '/' && <span class="dc-nav-dot" />}</a>)}
      </nav>
      <a class="dc-school-note" href="/school"><span class="dc-icon sage"><Icon name="leaf" size={23}/></span><strong>Big ideas.<br/>Little learners.</strong><p>A space to learn, play, and grow. Meet DailyCoder School.</p><span class="dc-text-link">Explore School <Icon name="arrow" size={16}/></span></a>
      <div class="dc-sidebar-foot"><Icon name="code" size={15}/><span>Made for curious minds.</span></div>
    </aside>

    <div class="dc-workspace" id="workspace" tabindex="-1">
      <div class="dc-welcome"><span>Your space to grow</span><span><i></i> A little better, every day</span></div>
      <section class="dc-hero" aria-labelledby="home-heading">
        <div class="dc-hero-copy">
          <p class="dc-kicker"><span class="dc-spark">✳</span> SMALL STEPS. REAL PROGRESS.</p>
          <h1 id="home-heading">A little practice.<br/>A lot of <em>possibility.</em></h1>
          <p>A place to sharpen your skills, bring ideas to life,<br class="dc-wide-break"/> and enjoy the journey. One day at a time.</p>
          <div class="dc-hero-actions"><a class="dc-button" href={challengeHref}>Let’s get coding <Icon name="arrow" size={18}/></a><a class="dc-button dc-button--quiet" href="/courses">Find your next course</a></div>
          <span class="dc-hero-note"><Icon name="lock" size={13}/> Free to explore. No account needed to start.</span>
        </div>
        <div class="dc-hero-art" aria-hidden="true">
          <div class="dc-art-orbit"></div><span class="dc-art-star">✳</span>
          <div class="dc-code-note"><div class="dc-code-top"><span><i></i><i></i><i></i></span><span>a-little-every-day.js</span></div><div class="dc-code-lines"><span class="dc-code-comment">// Good things take practice.</span><br/><span class="dc-code-purple">const</span> journey = {'{'}<br/>&nbsp; curiosity: <span class="dc-code-rust">"always"</span>,<br/>&nbsp; progress: <span class="dc-code-rust">"one step at a time"</span><br/>{'}'};<br/><br/><span class="dc-code-purple">while</span> (journey.curiosity) {'{'}<br/>&nbsp; learn();<br/>&nbsp; build();<br/>&nbsp; grow();<br/>{'}'}</div></div>
          <div class="dc-art-book"><Icon name="code" size={39}/><span>THE DAILY<br/>PRACTICE</span></div>
          <div class="dc-art-label"><Icon name="leaf" size={16}/> A little growth, every day.</div>
          <span class="dc-art-plus">+</span>
        </div>
      </section>

      <section class="dc-section" aria-labelledby="paths-heading">
        <div class="dc-section-heading"><h2 id="paths-heading">Where will curiosity take you?</h2><span>Make a little time for you.</span></div>
        <div class="dc-paths">{paths.map(p => <a class="dc-path" href={p.href}><span class={`dc-icon ${p.tone}`}><Icon name={p.icon} size={23}/></span><h3>{p.title}<Icon name="arrow" size={15}/></h3><p>{p.desc}</p></a>)}</div>
      </section>

      <div class="dc-dashboard">
        <div class="dc-main-column">
          <section class="dc-section" aria-labelledby="tools-heading">
            <div class="dc-section-heading"><div><p class="dc-kicker">LESS FRICTION, MORE FLOW</p><h2 id="tools-heading">Your everyday toolkit</h2></div><a class="dc-text-link" href="/tools">All tools <Icon name="arrow" size={16}/></a></div>
            <div class="dc-tools">{tools.map((tool, i) => tool && <a class="dc-tool" href={tool.href}><span class={`dc-tool-symbol ${['sage', 'peach', 'sky', 'lavender'][i]}`} aria-hidden="true">{tool.icon}</span><div><h3>{tool.name}</h3><p>{['Give your JSON a little order.', 'Find the pattern you’re looking for.', 'See what changed, side by side.', 'Turn your words into a preview.'][i]}</p></div><Icon name="arrow" size={16}/></a>)}</div>
            <p class="dc-tool-note"><Icon name="lock" size={13}/> These tools process your input in your browser.</p>
          </section>

          {courses.length > 0 && <section class="dc-section" aria-labelledby="courses-heading"><div class="dc-section-heading"><div><p class="dc-kicker">BUILD A STRONG FOUNDATION</p><h2 id="courses-heading">One lesson closer</h2></div><a class="dc-text-link" href="/courses">All courses <Icon name="arrow" size={16}/></a></div><div class="dc-courses">{courses.slice(0, 3).map((course, i) => <a class="dc-course" href={`/courses/${course.slug}`}><span class={`dc-course-cover ${['butter', 'sage', 'sky'][i]}`}><span>{course.title.startsWith('JavaScript') ? 'JS' : course.title.startsWith('Node') ? 'N' : course.title.startsWith('React') ? 'R' : course.title.charAt(0)}</span><Icon name="book" size={18}/></span><div><span class="dc-course-level">{course.level}</span><h3>{course.title}</h3><p>{course.totalLessons} lessons · At your own pace</p></div><Icon name="arrow" size={18}/></a>)}</div></section>}
        </div>

        <aside class="dc-right-column" aria-label="Your daily practice">
          <section id="daily-challenge" class="dc-challenge" aria-labelledby="challenge-heading"><div class="dc-section-heading"><p class="dc-kicker"><Icon name="bolt" size={15}/>{isDaily ? 'TODAY’S CHALLENGE' : 'A LITTLE CHALLENGE'}</p><Icon name="code" size={26}/></div><span class="dc-challenge-caption">A small stretch for your mind.</span><h2 id="challenge-heading">{featured?.title || 'Find your next challenge'}</h2><div class="dc-challenge-tags">{featured && <><span>{featured.difficulty}</span><span>{featured.topic}</span></>}</div>{featured?.sampleInput && <div class="dc-sample"><span>GIVE IT A TRY</span><code>{featured.sampleInput}</code>{featured.sampleOutput && <p>Expected output <strong>{featured.sampleOutput}</strong></p>}</div>}<a class="dc-button" href={challengeHref}>Try this challenge <Icon name="arrow" size={17}/></a><a class="dc-challenge-all" href="/problems">Explore all {problems.length} problems</a></section>
          <section class="dc-progress" aria-labelledby="progress-heading"><div class="dc-section-heading"><h2 id="progress-heading">Little steps add up.</h2><Icon name="leaf" size={20}/></div><p>Your daily challenge journey, so far.</p><div class="dc-progress-stats"><div><strong id="hp-streak">—</strong><span>Day streak</span></div><div><strong id="hp-solved">—</strong><span>Solved</span></div><div><strong id="hp-best">—</strong><span>Best streak</span></div></div><span class="dc-progress-note">Saved on this device. Sign in to sync.</span></section>
        </aside>
      </div>

      {posts.length > 0 && <section class="dc-section dc-reading" aria-labelledby="reading-heading"><div class="dc-section-heading"><div><p class="dc-kicker">FRESH PERSPECTIVES</p><h2 id="reading-heading">A good read goes a long way</h2></div><a class="dc-text-link" href="/blog">All articles <Icon name="arrow" size={16}/></a></div><div class="dc-articles">{posts.map((post, i) => <a class="dc-article" href={`/blog/${post.slug}`}><div class={`dc-article-art ${['sky', 'peach', 'lavender'][i]}`}>{post.image ? <img src={post.image} alt="" width="600" height="315" loading="lazy"/> : <Icon name="book" size={42}/>}</div><div class="dc-article-copy"><span class="dc-kicker">{post.category} <span>·</span> {calculateReadingTime(post.content)}</span><h3>{post.title}</h3><p>{post.description}</p><span class="dc-text-link">Take a look <Icon name="arrow" size={16}/></span></div></a>)}</div></section>}
      <section class="dc-newsletter" aria-label="Newsletter"><span class="dc-newsletter-art" aria-hidden="true"><Icon name="chat" size={46}/></span><Subscribe/></section>
    </div>
  </div>
<script id="home-daily-schedule" type="application/json" set:html={JSON.stringify(scheduleFullLite)} />
<script src="/js/store.js" is:inline></script>
<script>
  import { buildDailyStats } from '../utils/dailyStats';

  const PROGRESS_TOOL = 'problem-progress';
  const schedule: any[] = JSON.parse(document.getElementById('home-daily-schedule')?.textContent || '[]');

  function toDayKey(d: Date) { return d.toISOString().slice(0, 10); }

  async function init() {
    const now = new Date();
    const todayKey = toDayKey(now);
    const dailyData = schedule.filter((r) => (r.publishedAt || '').slice(0, 10) <= todayKey);
    const bySlug = Object.fromEntries(dailyData.map((r: any) => [r.slug, r]));

    await (window as any).DCStore.init();
    const rows = await (window as any).DCStore.getAll(PROGRESS_TOOL);
    const progressMap: Record<string, any> = {};
    rows.forEach((row: any) => {
      if (!bySlug[row.id]) return;
      progressMap[row.id] = {
        solved: !!row.solved,
        solvedAt: row.solvedAt || null,
        attempts: Number(row.attempts || 0),
        attemptsByDay: row.attemptsByDay || {},
        solutionUnlockedAt: row.solutionUnlockedAt || null,
        solutionUnlockPenaltyApplied: !!row.solutionUnlockPenaltyApplied,
      };
    });

    const stats = buildDailyStats(dailyData, progressMap, now);

    const set = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };
    set('hp-streak', String(stats.currentStreak));
    set('hp-solved', String(stats.totalSolved));
    set('hp-best', String(stats.longestStreak));
  }

  init();
</script>


</BaseLayout>
