---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Search from '../../components/Search.astro';
import { getBlogPostsSorted } from '../../utils/contentLoader';

const sortedPosts = getBlogPostsSorted();
---

<BaseLayout
  title="Blog | DailyCoder"
  description="Browse all blog posts about web development, TypeScript, CSS, and modern web technologies."
>
  <div class="container collection-page">
    <PageIntro title="Ideas worth a little time." description="Practical guides, thoughtful deep dives, and new perspectives for your next project." eyebrow="FROM THE DAILY CODER NOTEBOOK" icon="chat" tone="sky" />
    <Search />
    <div class="grid grid--3">
      {sortedPosts.map(post => (
        <PostCard
          title={post.title}
          description={post.description}
          date={new Date(post.date)}
          slug={post.slug}
          tags={post.tags}
          category={post.category}
          image={post.image}
          content={post.content}
        />
      ))}
    </div>
  </div>
</BaseLayout>
