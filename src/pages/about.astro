---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../utils/contentLoader';
import { ALL_TOOLS } from '../data/tools';
const config = getSiteConfig();
---

<BaseLayout
  title={`About | ${config.site.title}`}
  description="Learn more about DailyCoder — a platform for web development tutorials, courses, tools, and documentation."
>
  <div class="container collection-page">
    <PageIntro title="Built for curious minds." description="A place to practice, learn, and make something of your ideas. One small step at a time." eyebrow="HELLO FROM DAILY CODER" icon="leaf" tone="sage" />

    <div class="article__content about-content">
      <p>Founded by <strong>{config.site.author}</strong>, DailyCoder brings together practical tutorials, hands-on courses, and tools for everyday development.</p>
      <h2>What You'll Find Here</h2>
      <ul>
        <li><strong>Blog</strong> — In-depth articles on JavaScript, TypeScript, CSS, React, and modern web development</li>
        <li><strong>Courses</strong> — Structured learning paths with interactive quizzes and exercises</li>
        <li><strong>Documentation</strong> — Technical guides and project docs</li>
        <li><strong>Developer Tools</strong> — {ALL_TOOLS.length}+ free client-side tools (JSON formatter, diff checker, regex tester, and more)</li>
      </ul>
      
      <h2>Built With Modern Tech</h2>
      <p>
        This platform is built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 
        for blazing-fast performance, and hosted on GitHub Pages. Every tool runs 100% in your browser — 
        no data ever leaves your device.
      </p>
      
      <h2>Get in Touch</h2>
      <p>
        We love connecting with fellow developers! Reach out through any of these channels:
      </p>
      <ul>
        {config.socialLinks.twitter && (
          <li>Twitter/X: <a href={config.socialLinks.twitter} target="_blank" rel="noopener">@dailycoder_in</a></li>
        )}
        {config.socialLinks.github && (
          <li>GitHub: <a href={config.socialLinks.github} target="_blank" rel="noopener">@Avvinashjha</a></li>
        )}
        {config.socialLinks.linkedin && (
          <li>LinkedIn: <a href={config.socialLinks.linkedin} target="_blank" rel="noopener">DailyCoder</a></li>
        )}
        {config.socialLinks.youtube && (
          <li>YouTube: <a href={config.socialLinks.youtube} target="_blank" rel="noopener">@dailycoder</a></li>
        )}
        {config.socialLinks.instagram && (
          <li>Instagram: <a href={config.socialLinks.instagram} target="_blank" rel="noopener">@dailycoder.in</a></li>
        )}
        <li>Email: <a href="mailto:dailycoder.in@gmail.com">dailycoder.in@gmail.com</a></li>
      </ul>
      
      <p>
        Subscribe to the <a href="/rss.xml" target="_blank">RSS feed</a> to stay updated with new content!
      </p>
    </div>
  </div>
</BaseLayout>

<style>.about-content { max-width: 820px; margin: 0 auto; }</style>
