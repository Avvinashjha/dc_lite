---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOL_CATEGORIES as categories } from '../../data/tools';
---

<BaseLayout title="Free Developer Tools: JSON Formatter, Converter & More | DailyCoder" description="Private, fast browser tools for JSON formatting and conversion, code, regex, JWTs, colors, timestamps, and more. No sign-up or uploads.">
  <div class="container collection-page">
    <PageIntro title="Useful tools. One focused workspace at a time." description="Start with the job you need. Each workspace keeps the controls, conversions, and exports together — and your data stays in your browser." eyebrow="PRIVATE BY DEFAULT" icon="bolt" tone="sage" />

    <section class="tools-featured" aria-labelledby="featured-tool-heading">
      <div>
        <span class="tools-featured__eyebrow">MOST USED DATA WORKFLOW</span>
        <h2 id="featured-tool-heading">JSON Toolkit</h2>
        <p>Format and validate JSON, convert JSON and CSV, create JavaScript or TypeScript, sort keys, and compare payloads without hopping between tools.</p>
      </div>
      <a class="tools-featured__cta" href="/tools/json-formatter">Open JSON Toolkit <span aria-hidden="true">→</span></a>
    </section>

    <!-- Quick filter -->
    <div class="tools-filter">
      <button class="tools-filter__btn tools-filter__btn--active" data-filter="all">All</button>
      {categories.map(cat => (
        <button class="tools-filter__btn" data-filter={cat.name}>{cat.name}</button>
      ))}
    </div>

    <!-- Categorized sections -->
    {categories.map(cat => (
      <section class="tools-section" data-category={cat.name}>
        <h2 class="tools-section__title">
          <span class="tools-section__icon">{cat.icon}</span>
          {cat.name}
          <span class="tools-section__count">{cat.tools.length}</span>
        </h2>
        <div class="tools-grid">
          {cat.tools.map(tool => (
            <a href={tool.href} class="tool-card">
              <span class="tool-card__icon">{tool.icon}</span>
              <div>
                <h3 class="tool-card__name">{tool.name}</h3>
                <p class="tool-card__desc">{tool.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('.tools-filter__btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.tools-filter__btn').forEach(function(b) { b.classList.remove('tools-filter__btn--active'); });
      btn.classList.add('tools-filter__btn--active');
      var filter = btn.dataset.filter;
      document.querySelectorAll('.tools-section').forEach(function(sec) {
        sec.style.display = (filter === 'all' || sec.dataset.category === filter) ? '' : 'none';
      });
    });
  });
</script>

<style>
  .tools-filter {
    display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center;
    margin-bottom: 2.5rem; padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .tools-featured {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    margin: 0 0 2rem; padding: 1.25rem 1.4rem;
    border: 1px solid var(--dc-hero-line); border-radius: var(--radius-lg); background: var(--dc-hero);
  }
  .tools-featured__eyebrow { display: block; margin-bottom: 0.25rem; color: var(--dc-sage-ink); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.08em; }
  .tools-featured h2 { margin: 0 0 0.3rem; font-size: 1.25rem; }
  .tools-featured p { max-width: 680px; margin: 0; color: var(--color-text-light); font-size: 0.86rem; line-height: 1.55; }
  .tools-featured__cta { flex: 0 0 auto; padding: 0.65rem 0.8rem; border-radius: var(--radius-md); background: var(--color-primary); color: var(--color-on-primary); font-size: 0.8rem; font-weight: 750; text-decoration: none; }
  .tools-featured__cta:hover { color: var(--color-on-primary); background: var(--color-primary-dark); text-decoration: none; }
  .tools-filter__btn {
    padding: 0.4rem 1rem; border: 1px solid var(--color-border);
    border-radius: 100px; background: var(--color-surface); color: var(--color-text-light);
    font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 150ms;
    white-space: nowrap;
  }
  .tools-filter__btn:hover { border-color: var(--color-primary); color: var(--color-text); }
  .tools-filter__btn--active {
    background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary);
  }

  .tools-section { margin-bottom: 2.5rem; }
  .tools-section__title {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 1.25rem; margin-bottom: 1rem; padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .tools-section__icon { font-size: 1.1rem; }
  .tools-section__count {
    font-size: 0.7rem; font-weight: 700; background: var(--color-code-bg);
    color: var(--color-text-light); padding: 0.1rem 0.5rem; border-radius: 100px;
    margin-left: auto;
  }

  .tools-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;
  }
  .tool-card {
    display: flex; align-items: flex-start; gap: 0.75rem;
    padding: 1rem 1.1rem; border-radius: var(--radius-lg);
    border: 1px solid var(--color-border); background: var(--color-surface);
    text-decoration: none; color: inherit; transition: all 200ms ease;
  }
  .tool-card:hover {
    transform: translateY(-2px); box-shadow: var(--shadow-md);
    border-color: var(--color-primary); text-decoration: none; color: inherit;
  }
  .tool-card * { text-decoration: none; }
  .tool-card__icon {
    font-size: 1.1rem; font-weight: 700; font-family: var(--font-mono);
    background: var(--color-code-bg); width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md); flex-shrink: 0;
  }
  .tool-card__name { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.15rem; color: var(--color-text); }
  .tool-card__desc { font-size: 0.78rem; color: var(--color-text-light); line-height: 1.4; }

  @media (max-width: 1024px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .tools-grid { grid-template-columns: 1fr; } .tools-featured { align-items: flex-start; flex-direction: column; gap: 1rem; } }
</style>
