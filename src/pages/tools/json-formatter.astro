---
import ToolLayout from "../../layouts/ToolLayout.astro";
import CodeEditor from "../../components/CodeEditor.astro";
---

<ToolLayout
  title="JSON Formatter & Converter"
  description="Free online JSON formatter, validator, minifier, and converter. Format JSON, convert JSON to CSV, JavaScript, or TypeScript, convert CSV to JSON, sort keys, and compare payloads privately in your browser."
  toolName="JSON Formatter & Converter"
  keywords="json formatter, json beautifier, json validator, json minifier, json to csv, csv to json, json to javascript, json to typescript, json parser, format json online, pretty print json"
  features={['Format and validate JSON', 'Minify and sort JSON keys', 'Convert JSON to CSV and CSV to JSON', 'Export JavaScript and TypeScript', 'Compare JSON payloads', 'Private in-browser processing']}
  minimalHeader={true}
  faqs={[
    { q: "Is this JSON formatter safe to use with sensitive data?", a: "Yes. Everything runs locally in your browser — your JSON is never uploaded to any server, so you can safely paste API responses or config files." },
    { q: "What's the difference between Format and Minify?", a: "Format adds indentation and line breaks so JSON is easy to read, while Minify strips all whitespace to produce the smallest valid JSON for production." },
    { q: "Why does it say my JSON is invalid?", a: "The parser reports the first syntax error it finds — usually a missing comma, an extra trailing comma, unquoted keys, or single quotes instead of double quotes." },
    { q: "Can I convert JSON to CSV, JavaScript, or TypeScript?", a: "Yes. Open Convert above the workspace. JSON to CSV accepts one object or an array of objects; JavaScript and TypeScript exports are useful for fixtures, constants, and typed API models." },
    { q: "How do I rename a tab?", a: "Click the active tab name, enter its new name, and press OK. Your tabs are saved locally in your browser." },
  ]}
>
  <div class="tab-bar" id="tab-bar">
    <div class="tab-list" id="tab-list"></div>
    <button class="tab-add" id="btn-add-tab" type="button" title="New tab" aria-label="New tab">+</button>
  </div>

  <div id="split-workbench" class="jf-workbench" style="--left-pane: 50%;">
    <div class="tool-panel jf-pane jf-pane--left">
      <div class="jf-pane__head">
        <span class="tool-panel__label">Input</span>
        <div class="jf-pane__actions" aria-label="Transform or convert input">
          <button class="tool-btn tool-btn--primary" id="btn-format">Format</button>
          <button class="tool-btn" id="btn-minify">Minify</button>
          <button class="tool-btn" id="btn-validate">Validate</button>
          <button class="tool-btn" id="btn-sort">Sort</button>
          <details class="convert-menu">
            <summary class="tool-btn">Convert <span aria-hidden="true">⌄</span></summary>
            <div class="convert-menu__options" role="menu" aria-label="Convert JSON">
              <button id="btn-json-to-csv" type="button" role="menuitem">JSON to CSV</button>
              <button id="btn-csv-to-json" type="button" role="menuitem">CSV to JSON</button>
              <button id="btn-to-js" type="button" role="menuitem">JSON to JavaScript</button>
              <button id="btn-to-ts" type="button" role="menuitem">JSON to TypeScript</button>
            </div>
          </details>
        </div>
      </div>
      <textarea
        id="input"
        class="tool-textarea"
        placeholder='Paste JSON or CSV here…'></textarea>
    </div>

    <div
      id="pane-splitter"
      class="jf-splitter"
      role="separator"
      aria-label="Resize input and output panes"
      aria-orientation="vertical"
      tabindex="0"
    >
      <span></span>
    </div>

    <div class="tool-panel jf-pane jf-pane--right">
      <div class="jf-pane__head">
        <span class="tool-panel__label">Output</span>
        <div class="jf-pane__actions jf-pane__actions--output">
          <button class="tool-btn" id="btn-copy">Copy</button>
          <button class="tool-btn" id="btn-download">Download</button>
          <button class="tool-btn" id="btn-open-compare">Compare</button>
        </div>
      </div>
      <CodeEditor id="json-formatter-output" minHeight={250} fill={true} />
    </div>
  </div>
  <div id="status"></div>

  <section id="json-compare" class="json-compare" hidden aria-labelledby="json-compare-heading">
    <div class="json-compare__head">
      <div>
        <span class="tool-panel__label">JSON compare</span>
        <h2 id="json-compare-heading">Compare two JSON documents</h2>
      </div>
      <button class="tool-btn" id="btn-close-compare" type="button">Close</button>
    </div>
    <div class="json-compare__inputs">
      <label class="tool-panel"><span class="tool-panel__label">Original</span><textarea id="compare-a" class="tool-textarea" placeholder="Paste original JSON…"></textarea></label>
      <label class="tool-panel"><span class="tool-panel__label">Modified</span><textarea id="compare-b" class="tool-textarea" placeholder="Paste changed JSON…"></textarea></label>
    </div>
    <div class="tool-actions json-compare__actions">
      <button class="tool-btn tool-btn--primary" id="btn-run-compare" type="button">Compare</button>
      <button class="tool-btn" id="btn-swap-compare" type="button">Swap</button>
    </div>
    <div id="compare-status" aria-live="polite"></div>
    <div id="compare-output" class="json-compare__output" aria-live="polite"></div>
  </section>

  <section slot="about" class="tool-about">
    <h2>Format, validate, and convert JSON in one workspace</h2>
    <p>
      JSON (JavaScript Object Notation) is everywhere — API responses, config files, database exports, package manifests.
      But raw JSON from an API or a minified file is nearly impossible to read. A formatter takes that dense blob of text
      and adds proper indentation and line breaks so you can actually see the structure.
    </p>
    <p>
      This tool parses your JSON, checks that it's valid, and outputs standard prettified JSON (indentation and quoted keys).
      <strong>Format</strong> rebuilds the value into clean JSON; <strong>Sort keys</strong> makes large payloads easier to compare.
      If something's wrong — a missing comma, an extra bracket, an unquoted key — you'll get a clear error pointing to the problem.
    </p>

    <h3>When You'd Use This</h3>
    <ul>
      <li><strong>Debugging API responses</strong> — Paste the raw response and see nested objects clearly</li>
      <li><strong>Editing config files</strong> — Format <code>package.json</code>, <code>tsconfig.json</code>, or any config before making changes</li>
      <li><strong>Validating data</strong> — Quickly check if a JSON string is well-formed before sending it somewhere</li>
      <li><strong>Minifying for production</strong> — Strip whitespace to reduce payload size</li>
    </ul>

    <h3>Tips</h3>
    <p>
      Use multiple tabs to keep different payloads available. Your tabs auto-save to the browser, so they'll still
      be there when you come back. Use <strong>Compare JSON</strong> when you need to inspect structural differences
      between two payloads.
    </p>
  </section>
</ToolLayout>

<script src="/js/store.js" is:inline></script>
<script>
  import { createCodeEditor } from "../../utils/codeEditor";

  var TOOL = "json-formatter";
  var tabs = [];
  var activeTab = null;
  var input = document.getElementById("input");
  var status = document.getElementById("status");
  var splitter = document.getElementById("pane-splitter");
  var workbench = document.getElementById("split-workbench");
  var outputEditor = createCodeEditor({
    rootId: "json-formatter-output",
    doc: "",
    language: "json",
    readOnly: true,
    lineWrapping: true,
  });

  var MAX_JSON_STRING_UNWRAP = 12;
  var outputType = "json";

  function looksLikeJsonDocument(s) {
    s = s.trim();
    if (s.length < 2) return false;
    var a = s[0];
    var b = s[s.length - 1];
    return (a === "{" && b === "}") || (a === "[" && b === "]");
  }

  /** Parse input; if the value is a JSON string containing JSON, unwrap until object/array or limit. */
  function parseJsonInput(text) {
    var value = JSON.parse(text.trim());
    var n = 0;
    while (typeof value === "string" && n < MAX_JSON_STRING_UNWRAP) {
      var inner = value.trim();
      if (!looksLikeJsonDocument(inner)) break;
      try {
        value = JSON.parse(inner);
        n++;
      } catch (e) {
        break;
      }
    }
    return value;
  }

  function getOutput() {
    return outputEditor.getValue();
  }

  function setOutput(value) {
    outputEditor.setValue(value || "");
  }

  function setStatus(msg, type) {
    status.className = type === "error" ? "tool-error" : "tool-success";
    status.textContent = msg;
  }

  function setResult(value, language, type) {
    outputEditor.setLanguage(language || "text");
    setOutput(value);
    outputType = type || "txt";
  }

  function sortJson(value) {
    if (Array.isArray(value)) return value.map(sortJson);
    if (value && typeof value === "object") {
      var result = {};
      Object.keys(value).sort().forEach(function (key) { result[key] = sortJson(value[key]); });
      return result;
    }
    return value;
  }

  function parseCsv(text) {
    var rows = [];
    var row = [];
    var field = "";
    var quoted = false;
    for (var i = 0; i < text.length; i++) {
      var char = text[i];
      if (quoted) {
        if (char === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (char === '"') quoted = false;
        else field += char;
      } else if (char === '"') quoted = true;
      else if (char === ",") { row.push(field); field = ""; }
      else if (char === "\n" || char === "\r") {
        if (char === "\r" && text[i + 1] === "\n") i++;
        row.push(field); field = "";
        if (row.some(function (cell) { return cell !== ""; })) rows.push(row);
        row = [];
      } else field += char;
    }
    if (quoted) throw new Error("CSV has an unclosed quoted value");
    row.push(field);
    if (row.some(function (cell) { return cell !== ""; })) rows.push(row);
    if (rows.length < 2) throw new Error("CSV needs a header row and at least one data row");
    var headers = rows[0].map(function (header, index) { return (header || "column_" + (index + 1)).trim(); });
    return rows.slice(1).map(function (values) {
      var item = {};
      headers.forEach(function (header, index) {
        var value = values[index] == null ? "" : values[index];
        item[header] = value === "" ? "" : value === "true" ? true : value === "false" ? false : value === "null" ? null : (/^-?(?:\d+|\d*\.\d+)$/.test(value) ? Number(value) : value);
      });
      return item;
    });
  }

  function flattenForCsv(value, prefix, result) {
    if (Array.isArray(value)) { result[prefix] = JSON.stringify(value); return; }
    if (value && typeof value === "object") {
      Object.keys(value).forEach(function (key) {
        flattenForCsv(value[key], prefix ? prefix + "." + key : key, result);
      });
      return;
    }
    result[prefix] = value == null ? "" : value;
  }

  function toCsv(value) {
    // A single JSON object is a useful one-row CSV, not an error.
    var values = Array.isArray(value) ? value : [value];
    if (!values.length || values.some(function (item) { return !item || typeof item !== "object" || Array.isArray(item); })) {
      throw new Error("JSON to CSV needs an object or a non-empty array of objects");
    }
    var rows = values.map(function (item) { var flat = {}; flattenForCsv(item, "", flat); return flat; });
    var seen = {};
    var headers = [];
    rows.forEach(function (row) { Object.keys(row).forEach(function (key) { if (!seen[key]) { seen[key] = true; headers.push(key); } }); });
    function quote(cell) { var text = String(cell == null ? "" : cell); return /[",\n\r]/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text; }
    return headers.map(quote).join(",") + "\n" + rows.map(function (row) { return headers.map(function (header) { return quote(row[header]); }).join(","); }).join("\n");
  }

  function typeName(value, depth) {
    var pad = new Array((depth || 0) + 1).join("  ");
    var nextPad = new Array((depth || 0) + 2).join("  ");
    if (value === null) return "null";
    if (Array.isArray(value)) {
      if (!value.length) return "unknown[]";
      var itemTypes = [];
      value.slice(0, 20).forEach(function (item) { var type = typeName(item, (depth || 0) + 1); if (itemTypes.indexOf(type) === -1) itemTypes.push(type); });
      return "(" + itemTypes.join(" | ") + ")[]";
    }
    if (typeof value === "object") {
      var keys = Object.keys(value);
      if (!keys.length) return "Record<string, never>";
      return "{\n" + keys.map(function (key) { return nextPad + ( /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(key) ? key : JSON.stringify(key) ) + ": " + typeName(value[key], (depth || 0) + 1) + ";"; }).join("\n") + "\n" + pad + "}";
    }
    return typeof value;
  }

  function jsonPath(base, key, isArray) {
    if (isArray) return base + "[" + key + "]";
    return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(key) ? base + "." + key : base + "[" + JSON.stringify(key) + "]";
  }

  function previewValue(value) {
    var text = typeof value === "string" ? JSON.stringify(value) : JSON.stringify(value);
    return text.length > 180 ? text.slice(0, 177) + "…" : text;
  }

  function structuralDiff(before, after, path, changes) {
    if (JSON.stringify(before) === JSON.stringify(after)) return;
    var beforeIsObject = before && typeof before === "object";
    var afterIsObject = after && typeof after === "object";
    var bothArrays = Array.isArray(before) && Array.isArray(after);
    var bothObjects = beforeIsObject && afterIsObject && !Array.isArray(before) && !Array.isArray(after);
    if (bothArrays) {
      var max = Math.max(before.length, after.length);
      for (var index = 0; index < max; index++) {
        if (index >= before.length) changes.push({ kind: "added", path: jsonPath(path, index, true), after: after[index] });
        else if (index >= after.length) changes.push({ kind: "removed", path: jsonPath(path, index, true), before: before[index] });
        else structuralDiff(before[index], after[index], jsonPath(path, index, true), changes);
      }
      return;
    }
    if (bothObjects) {
      var keys = {};
      Object.keys(before).forEach(function (key) { keys[key] = true; });
      Object.keys(after).forEach(function (key) { keys[key] = true; });
      Object.keys(keys).sort().forEach(function (key) {
        if (!(key in before)) changes.push({ kind: "added", path: jsonPath(path, key, false), after: after[key] });
        else if (!(key in after)) changes.push({ kind: "removed", path: jsonPath(path, key, false), before: before[key] });
        else structuralDiff(before[key], after[key], jsonPath(path, key, false), changes);
      });
      return;
    }
    changes.push({ kind: "changed", path: path, before: before, after: after });
  }

  function escapeHtml(value) {
    return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\"/g, "&quot;");
  }

  function renderComparison(changes) {
    if (!changes.length) return '<div class="json-compare__empty">The documents are structurally identical.</div>';
    return '<div class="json-compare__summary">' + changes.length + ' change' + (changes.length === 1 ? '' : 's') + '</div><ul class="json-compare__list">' + changes.map(function (change) {
      var before = change.kind === "added" ? "" : '<code>' + escapeHtml(previewValue(change.before)) + '</code>';
      var after = change.kind === "removed" ? "" : '<code>' + escapeHtml(previewValue(change.after)) + '</code>';
      var arrow = change.kind === "changed" ? '<span aria-hidden="true">→</span>' : '';
      return '<li class="json-compare__change json-compare__change--' + change.kind + '"><span class="json-compare__kind">' + change.kind + '</span><code class="json-compare__path">' + escapeHtml(change.path) + '</code><span class="json-compare__values">' + before + arrow + after + '</span></li>';
    }).join("") + '</ul>';
  }

  function genId() {
    return "tab-" + Date.now().toString(36);
  }

  // --- Tab rendering ---
  function renderTabs() {
    var list = document.getElementById("tab-list");
    list.innerHTML = "";
    tabs.forEach(function (tab) {
      var el = document.createElement("div");
      el.className = "tab-item" + (tab.id === activeTab ? " tab-item--active" : "");
      el.setAttribute("role", "tab");
      el.setAttribute("tabindex", "0");
      el.setAttribute("aria-selected", String(tab.id === activeTab));
      el.innerHTML =
        '<span class="tab-item__name">' +
        (tab.name || "Untitled") +
        "</span>" +
        (tabs.length > 1
          ? '<button class="tab-item__close" data-id="' +
            tab.id +
            '">&times;</button>'
          : "");
      function selectOrRename(e) {
        if (e && e.target.classList.contains("tab-item__close")) return;
        if (tab.id === activeTab) renameTab(tab);
        else switchTab(tab.id);
      }
      el.addEventListener("click", selectOrRename);
      el.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selectOrRename(e); }
      });
      list.appendChild(el);
    });
    // Close buttons
    list.querySelectorAll(".tab-item__close").forEach(function (btn) {
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        closeTab(btn.dataset.id);
      });
    });
  }

  function switchTab(id) {
    // Save current
    saveCurrentToMemory();
    activeTab = id;
    var tab = tabs.find(function (t) {
      return t.id === id;
    });
    if (tab) {
      input.value = tab.content || "";
      setOutput(tab.output || "");
      status.textContent = "";
    }
    renderTabs();
  }

  function saveCurrentToMemory() {
    var tab = tabs.find(function (t) {
      return t.id === activeTab;
    });
    if (tab) {
      tab.content = input.value;
      tab.output = getOutput();
    }
  }

  function addTab(data) {
    var tab = {
      id: genId(),
      name: (data && data.name) || "Tab " + (tabs.length + 1),
      content: (data && data.content) || "",
      output: "",
    };
    tabs.push(tab);
    switchTab(tab.id);
  }

  function renameTab(tab) {
    var item = document.querySelector(".tab-item--active");
    if (!tab || !item) return;
    var field = document.createElement("input");
    field.className = "tab-item__rename";
    field.value = tab.name || "";
    field.setAttribute("aria-label", "Rename JSON tab");
    item.replaceChildren(field); field.focus(); field.select();
    var done = false;
    function finish() {
      if (done) return; done = true;
      tab.name = field.value.trim() || "Untitled";
      renderTabs(); saveToDB(); setStatus("Tab renamed", "success");
    }
    field.addEventListener("click", function(e) { e.stopPropagation(); });
    field.addEventListener("keydown", function(e) { if (e.key === "Enter") finish(); if (e.key === "Escape") { done = true; renderTabs(); } });
    field.addEventListener("blur", finish);
  }

  function closeTab(id) {
    if (tabs.length <= 1) return;
    tabs = tabs.filter(function (t) {
      return t.id !== id;
    });
    if (activeTab === id) switchTab(tabs[0].id);
    else renderTabs();
    saveToDB();
  }

  // --- IndexedDB persistence ---
  async function saveToDB() {
    saveCurrentToMemory();
    await DCStore.init();
    await DCStore.clear(TOOL);
    for (var i = 0; i < tabs.length; i++) {
      await DCStore.set(TOOL, tabs[i].id, {
        name: tabs[i].name,
        content: tabs[i].content,
        order: i,
        isActive: tabs[i].id === activeTab,
      });
    }
  }

  async function loadFromDB() {
    await DCStore.init();
    var items = await DCStore.getAll(TOOL);
    if (items.length === 0) {
      addTab({ name: "Tab 1" });
      return;
    }
    items.sort(function (a, b) {
      return (a.order || 0) - (b.order || 0);
    });
    tabs = items.map(function (item) {
      return {
        id: item.id,
        name: item.name,
        content: item.content || "",
      output: "",
      };
    });
    var active = items.find(function (i) {
      return i.isActive;
    });
    activeTab = active ? active.id : tabs[0].id;
    var tab = tabs.find(function (t) {
      return t.id === activeTab;
    });
    input.value = tab ? tab.content : "";
    renderTabs();
  }

  // --- Actions ---
  document.getElementById("btn-format").addEventListener("click", function () {
    try {
      var parsed = parseJsonInput(input.value);
      setResult(JSON.stringify(parsed, null, 2), "json", "json");
      setStatus("Formatted", "success");
    } catch (e) {
      setOutput("");
      setStatus("Invalid JSON: " + e.message, "error");
    }
  });

  document.getElementById("btn-minify").addEventListener("click", function () {
    try {
      setResult(JSON.stringify(parseJsonInput(input.value)), "json", "json");
      setStatus("Minified", "success");
    } catch (e) {
      setOutput("");
      setStatus("Invalid JSON: " + e.message, "error");
    }
  });

  document.getElementById("btn-sort").addEventListener("click", function () {
    try {
      var parsed = parseJsonInput(input.value);
      setResult(JSON.stringify(sortJson(parsed), null, 2), "json", "json");
      setStatus("Sorted keys alphabetically", "success");
    } catch (e) {
      setOutput("");
      setStatus("Invalid JSON: " + e.message, "error");
    }
  });

  document
    .getElementById("btn-validate")
    .addEventListener("click", function () {
      try {
        parseJsonInput(input.value);
        setResult("Valid JSON ✓", "text", "txt");
        setStatus("Valid JSON!", "success");
      } catch (e) {
        setOutput("");
        setStatus("Invalid: " + e.message, "error");
      }
    });

  document.getElementById("btn-json-to-csv").addEventListener("click", function () {
    try {
      var csv = toCsv(parseJsonInput(input.value));
      setResult(csv, "text", "csv");
      setStatus("Converted JSON to CSV", "success");
    } catch (e) { setOutput(""); setStatus("Could not convert: " + e.message, "error"); }
  });

  document.getElementById("btn-csv-to-json").addEventListener("click", function () {
    try {
      var json = parseCsv(input.value);
      setResult(JSON.stringify(json, null, 2), "json", "json");
      setStatus("Converted " + json.length + " CSV rows to JSON", "success");
    } catch (e) { setOutput(""); setStatus("Could not convert: " + e.message, "error"); }
  });

  document.getElementById("btn-to-js").addEventListener("click", function () {
    try {
      setResult("const data = " + JSON.stringify(parseJsonInput(input.value), null, 2) + ";\n", "javascript", "js");
      setStatus("Created a JavaScript object", "success");
    } catch (e) { setOutput(""); setStatus("Invalid JSON: " + e.message, "error"); }
  });

  document.getElementById("btn-to-ts").addEventListener("click", function () {
    try {
      var data = parseJsonInput(input.value);
      var declaration = "export type Data = " + typeName(data, 0) + ";\n\nexport const data: Data = " + JSON.stringify(data, null, 2) + ";\n";
      setResult(declaration, "javascript", "ts");
      setStatus("Created a TypeScript type and value", "success");
    } catch (e) { setOutput(""); setStatus("Invalid JSON: " + e.message, "error"); }
  });

  document.querySelectorAll(".convert-menu__options button").forEach(function (button) {
    button.addEventListener("click", function () {
      button.closest("details").removeAttribute("open");
    });
  });

  var compareWorkspace = document.getElementById("json-compare");
  var compareA = document.getElementById("compare-a");
  var compareB = document.getElementById("compare-b");
  var compareStatus = document.getElementById("compare-status");
  var compareOutput = document.getElementById("compare-output");

  function openCompare() {
    compareWorkspace.hidden = false;
    if (!compareA.value.trim()) compareA.value = input.value;
    window.location.hash = "compare";
    compareA.focus();
  }

  document.getElementById("btn-open-compare").addEventListener("click", openCompare);
  document.getElementById("btn-close-compare").addEventListener("click", function () {
    compareWorkspace.hidden = true;
    compareStatus.textContent = "";
    compareOutput.innerHTML = "";
    history.replaceState(null, "", window.location.pathname + window.location.search);
  });
  document.getElementById("btn-swap-compare").addEventListener("click", function () {
    var original = compareA.value;
    compareA.value = compareB.value;
    compareB.value = original;
  });
  document.getElementById("btn-run-compare").addEventListener("click", function () {
    try {
      var changes = [];
      structuralDiff(parseJsonInput(compareA.value), parseJsonInput(compareB.value), "$", changes);
      compareStatus.className = "tool-success";
      compareStatus.textContent = changes.length ? "Comparison complete" : "Objects are identical";
      compareOutput.innerHTML = renderComparison(changes);
    } catch (e) {
      compareStatus.className = "tool-error";
      compareStatus.textContent = "Invalid JSON: " + e.message;
      compareOutput.innerHTML = "";
    }
  });

  document.getElementById("btn-copy").addEventListener("click", function () {
    var currentOutput = getOutput();
    if (currentOutput) {
      navigator.clipboard.writeText(currentOutput);
      setStatus("Copied!", "success");
    }
  });

  document
    .getElementById("btn-download")
    .addEventListener("click", function () {
      var currentOutput = getOutput();
      if (!currentOutput) return;
      var type = outputType === "csv" ? "text/csv" : outputType === "json" ? "application/json" : "text/plain";
      var blob = new Blob([currentOutput], { type: type });
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download =
        (tabs.find(function (t) {
          return t.id === activeTab;
        }).name || "converted") + "." + outputType;
      a.click();
    });

  document.getElementById("btn-add-tab").addEventListener("click", function () {
    addTab();
    saveToDB();
  });

  // Auto-save on input
  var saveTimer;
  input.addEventListener("input", function () {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function () {
      saveToDB();
    }, 1000);
  });

  // Init
  (function initSplitter() {
    if (!splitter || !workbench) return;

    // Keyboard support
    splitter.addEventListener("keydown", function (e) {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      var current =
        Number(
          (workbench.style.getPropertyValue("--left-pane") || "50").replace(
            "%",
            "",
          ),
        ) || 50;
      var step = 2;
      var newValue = Math.max(
        20,
        Math.min(80, current + (e.key === "ArrowLeft" ? -step : step)),
      );
      workbench.style.setProperty("--left-pane", newValue + "%");
    });

    // Drag support
    splitter.addEventListener("mousedown", function (e) {
      if (window.matchMedia("(max-width: 980px)").matches) return;
      e.preventDefault();

      var leftPane = workbench.querySelector(".jf-pane--left");
      var startX = e.clientX;
      var startWidth = leftPane.getBoundingClientRect().width;
      var totalWidth = workbench.getBoundingClientRect().width;
      var splitterWidth = splitter.offsetWidth || 12;

      workbench.classList.add("jf-workbench--dragging");
      document.body.style.cursor = "col-resize";
      document.body.style.userSelect = "none";

      var currentX = startX;
      var rafId = null;

      function update() {
        var delta = currentX - startX;
        var newWidth = startWidth + delta;

        // Constraints
        var minW = 300;
        var maxW = totalWidth - splitterWidth - 320;
        var clampedWidth = Math.max(minW, Math.min(maxW, newWidth));

        var percent = (clampedWidth / totalWidth) * 100;
        workbench.style.setProperty("--left-pane", percent + "%");
        rafId = null;
      }

      function onMouseMove(moveEvent) {
        currentX = moveEvent.clientX;
        if (!rafId) {
          rafId = requestAnimationFrame(update);
        }
      }

      function onMouseUp() {
        window.removeEventListener("mousemove", onMouseMove);
        window.removeEventListener("mouseup", onMouseUp);
        workbench.classList.remove("jf-workbench--dragging");
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      }

      window.addEventListener("mousemove", onMouseMove);
      window.addEventListener("mouseup", onMouseUp);
    });
  })();

  if (window.location.hash === "#compare") openCompare();

  loadFromDB();
</script>

