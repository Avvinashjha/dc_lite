---
import ToolLayout from "../../layouts/ToolLayout.astro";
import CodeEditor from "../../components/CodeEditor.astro";
---

<ToolLayout
  title="JavaScript Formatter"
  description="Format JavaScript in your browser with a reliable Prettier-based formatter, configurable indentation, and side-by-side syntax-highlighted preview."
  toolName="JavaScript Formatter"
  keywords="javascript formatter, js formatter, js beautifier, format javascript online, prettier javascript formatter"
  features={['Format JavaScript with Prettier', 'Choose 2 or 4 spaces', 'Syntax-highlighted preview', 'Private in-browser processing']}
  workbench={true}
  faqs={[
    { q: "What languages can it format?", a: "This workspace is focused on JavaScript. For JSON, use the JSON Toolkit, which also validates, converts, and compares data." },
    { q: "Does it send my code to a server?", a: "No. Formatting and preview run completely client-side in your browser." },
    { q: "Will formatting change how my JavaScript runs?", a: "No. The formatter only rewrites whitespace and layout. It reports syntax errors rather than guessing how to repair broken code." },
  ]}
>
  <div class="formatter-toolbar">
    <div class="formatter-toolbar__field">
      <label class="tool-panel__label" for="indent-size">Indent</label>
      <input id="indent-size" type="hidden" value="2" />
      <details class="select-menu" id="indent-menu">
        <summary class="select-menu__trigger"><span id="indent-label">2 spaces</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
        <div class="select-menu__options" role="menu" aria-label="Indent size">
          <button type="button" data-indent="2" role="menuitemradio" aria-checked="true">2 spaces</button>
          <button type="button" data-indent="4" role="menuitemradio" aria-checked="false">4 spaces</button>
        </div>
      </details>
    </div>
    <div class="formatter-toolbar__actions">
      <button id="btn-format" class="tool-btn tool-btn--primary">Format</button>
      <button id="btn-copy" class="tool-btn">Copy</button>
      <button id="btn-sample" class="tool-btn">Sample</button>
      <button id="btn-clear" class="tool-btn">Clear</button>
    </div>
  </div>

  <div class="tool-panels">
    <div class="tool-panel">
      <span class="tool-panel__label">Input</span>
      <CodeEditor id="code-formatter-input" minHeight={320} fill={true} />
    </div>
    <div class="tool-panel">
      <span class="tool-panel__label">Preview</span>
      <CodeEditor id="code-formatter-output" minHeight={320} fill={true} />
    </div>
  </div>

  <div id="status"></div>

  <section slot="about" class="tool-about">
    <h2>Why Format Code?</h2>
    <p>
      Consistent formatting makes JavaScript easier to read, review, and maintain. This workspace uses Prettier’s
      JavaScript parser in the browser, with a syntax-highlighted preview before you copy the result.
    </p>

    <h3>Focused on JavaScript</h3>
    <p>
      Paste JavaScript, choose two or four spaces, and hit Format. The side-by-side CodeMirror preview shows the
      result with proper syntax highlighting so you can verify it looks right before copying. For API payloads or
      config data, use the <a href="/tools/json-formatter">JSON Toolkit</a> instead.
    </p>

    <h3>Formatting, not unsafe compression</h3>
    <p>
      This workspace deliberately does not pretend to be a production minifier. Minifying JavaScript safely requires
      a full parser and build-aware optimisation; use your project’s bundler for that. Here, the goal is reliable,
      readable formatting.
    </p>
  </section>
</ToolLayout>

<script>
  import { createCodeEditor } from "../../utils/codeEditor";
  import { formatJavaScript } from "../../utils/formatJavaScript";

  const sampleCode = [
      "const users=[{name:'Ada',score:90},{name:'Linus',score:84}];",
      "function topScorer(items){return items.sort((a,b)=>b.score-a.score)[0]}",
      "console.log(topScorer(users));",
    ].join("\n");

  const statusEl = document.getElementById("status");
  const indentEl = document.getElementById("indent-size");
  const formatBtn = document.getElementById("btn-format");
  const copyBtn = document.getElementById("btn-copy");
  const sampleBtn = document.getElementById("btn-sample");
  const clearBtn = document.getElementById("btn-clear");
  const indentLabel = document.getElementById("indent-label");

  const inputEditor = createCodeEditor({
    rootId: "code-formatter-input",
    doc: sampleCode,
    language: "javascript",
    lineWrapping: true,
  });

  const outputEditor = createCodeEditor({
    rootId: "code-formatter-output",
    doc: "",
    language: "javascript",
    readOnly: true,
    lineWrapping: true,
  });

  function setStatus(message, type) {
    statusEl.className = type === "error" ? "tool-error" : "tool-success";
    statusEl.textContent = message;
  }

  async function runFormatter() {
    const indentSize = Number(indentEl.value);
    const source = inputEditor.getValue().trim();

    if (!source) {
      outputEditor.setValue("");
      setStatus("Input is empty.", "error");
      return;
    }

    try {
      const result = await formatJavaScript(source, { tabWidth: indentSize });

      outputEditor.setValue(result);
      setStatus("Formatted successfully.", "success");
    } catch (error) {
      outputEditor.setValue("");
      setStatus("Unable to process input: " + (error && error.message ? error.message : String(error)), "error");
    }
  }

  formatBtn.addEventListener("click", function () {
    runFormatter();
  });

  copyBtn.addEventListener("click", function () {
    const value = outputEditor.getValue();
    if (!value) {
      setStatus("No output to copy.", "error");
      return;
    }
    navigator.clipboard.writeText(value);
    setStatus("Output copied.", "success");
  });

  sampleBtn.addEventListener("click", function () {
    inputEditor.setValue(sampleCode);
    outputEditor.setValue("");
    setStatus("Sample loaded.", "success");
  });

  clearBtn.addEventListener("click", function () {
    inputEditor.setValue("");
    outputEditor.setValue("");
    setStatus("Cleared.", "success");
  });

  document.querySelectorAll("[data-indent]").forEach(function (option) {
    option.addEventListener("click", function () {
      indentEl.value = option.dataset.indent;
      indentLabel.textContent = option.textContent;
      document.querySelectorAll("[data-indent]").forEach(function (item) {
        item.setAttribute("aria-checked", String(item === option));
      });
      document.getElementById("indent-menu").removeAttribute("open");
    });
  });
</script>

<style>
  .formatter-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .formatter-toolbar__field { display: flex; align-items: center; gap: 0.35rem; }
  .select-menu { position: relative; }
  .select-menu > summary { list-style: none; cursor: pointer; }
  .select-menu > summary::-webkit-details-marker { display: none; }
  .select-menu__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 112px;
    min-height: 32px;
    gap: 0.5rem;
    padding: 0.35rem 0.45rem 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .select-menu__trigger svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; transition: transform 140ms ease; }
  .select-menu[open] .select-menu__trigger { border-color: var(--color-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .select-menu[open] .select-menu__trigger svg { transform: rotate(180deg); }
  .select-menu__options {
    position: absolute;
    z-index: 12;
    top: calc(100% + 0.35rem);
    left: 0;
    display: grid;
    width: 150px;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }
  .select-menu__options button {
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.45rem 0.55rem;
    font: inherit;
    font-size: 0.78rem;
    text-align: left;
  }
  .select-menu__options button:hover,
  .select-menu__options button:focus-visible { background: var(--color-code-bg); color: var(--color-primary); outline: none; }
  .formatter-toolbar__actions { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .formatter-toolbar__actions .tool-btn { min-height: 32px; padding: 0.35rem 0.65rem; }
  @media (max-width: 620px) {
    .formatter-toolbar { align-items: stretch; }
    .formatter-toolbar__field { justify-content: space-between; }
  }
</style>
