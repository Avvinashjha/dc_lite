---
import type { ProblemItem } from '../types/post';
import { slugifyTaxonomy } from '../utils/taxonomy';

interface Props {
  problem: ProblemItem;
  /** Omit title/meta row when the parent page already shows them (e.g. daily detail). */
  embedded?: boolean;
}

const { problem, embedded = false } = Astro.props;
const topics = problem.topics?.length ? problem.topics : [problem.topic];
const constraints = problem.constraints
  ? (Array.isArray(problem.constraints) ? problem.constraints : [problem.constraints])
  : [];
const followUps = problem.followUps
  ? (Array.isArray(problem.followUps) ? problem.followUps : [problem.followUps])
  : [];
const examples = Array.isArray(problem.examples) ? problem.examples : [];
const visuals = Array.isArray(problem.visuals) ? problem.visuals : [];
function visualWidth(svg: string): string {
  const viewBox = svg.match(/viewBox=["']([^"']+)["']/i)?.[1].trim().split(/[\s,]+/).map(Number);
  const width = viewBox?.[2];
  return width && Number.isFinite(width) && width > 0 ? `${width}px` : '100%';
}
---

<div class:list={['problem-desc', embedded && 'problem-desc--embedded']}>
  {!embedded && (
    <div class="problem-desc__header">
      <h1 class="problem-desc__title">{problem.title}</h1>
      <div class="problem-desc__meta">
        <span class={`p-badge p-badge--${problem.difficulty.toLowerCase()}`}>{problem.difficulty}</span>
        {topics.map(t => <span class="p-badge p-badge--neutral">{t}</span>)}

      </div>
    </div>
  )}

  <div class="problem-desc__body" set:html={problem.descriptionHtml} />

  {(problem.inputFormat || (problem.outputFormat && problem.outputFormat !== 'Return the result described in the statement.')) && (
    <details class="problem-details problem-contract-details">
      <summary>Function contract</summary>
      {problem.inputFormat && <p class="problem-contract">{problem.inputFormat.replace(' Inputs below show JavaScript function arguments; there is no stdin parsing.', '')}</p>}
      {problem.outputFormat && problem.outputFormat !== 'Return the result described in the statement.' && <p class="problem-contract"><strong>Output:</strong> {problem.outputFormat}</p>}
    </details>
  )}

  {examples.length > 0 && (
    <section class="problem-section" aria-label="Examples">
      {examples.map((ex, idx) => (
        <div class="problem-sample">
          <h2>Example {idx + 1}</h2>
          <div class="problem-sample__values">
            <div><strong>Input</strong><pre><code>{ex.input}</code></pre></div>
            <div><strong>Output</strong><pre><code>{ex.output}</code></pre></div>
          </div>
          {ex.explanation && <p><strong>Explanation:</strong> {ex.explanation}</p>}
        </div>
      ))}
    </section>
  )}

  {visuals.length > 0 && (
    <div class="problem-section">
      <div class="problem-section__heading">Visual Aid</div>
      {visuals.map((visual) => (
        <figure class="problem-visual" style="margin:0.75rem 0;padding:0.75rem;border:1px solid var(--color-border);border-radius:10px;background:var(--color-code-bg);">
          {visual.title && <figcaption style="font-weight:700;margin-bottom:0.45rem;">{visual.title}</figcaption>}
          {visual.imageUrl && <img src={visual.imageUrl} alt={visual.caption || visual.title || 'Problem visual'} loading="lazy" />}
          {visual.svg && <div style={`max-width:${visualWidth(visual.svg)};margin-inline:auto;`} set:html={visual.svg} />}
          {visual.caption && <p style="margin:0.4rem 0 0;color:var(--color-text-light);font-size:0.82rem;">{visual.caption}</p>}
        </figure>
      ))}
    </div>
  )}

  {constraints.length > 0 && (
    <details class="problem-section problem-details" open>
      <summary class="problem-section__heading">Constraints</summary>
      <ul class="problem-constraints">
        {constraints.map(c => <li>{c}</li>)}
      </ul>
    </details>
  )}

  {followUps.length > 0 && (
    <div class="problem-section">
      <div class="problem-section__heading">Follow-up</div>
      <ul class="problem-constraints">
        {followUps.map(f => <li>{f}</li>)}
      </ul>
    </div>
  )}

  <div class="problem-section">
    <div class="problem-section__heading">Topics</div>
    <div class="problem-topics">
      {topics.map(t => (
        <a href={`/problems/topic/${slugifyTaxonomy(t)}`} class="p-badge p-badge--neutral" style="text-decoration:none;">{t}</a>
      ))}
    </div>
  </div>
</div>
