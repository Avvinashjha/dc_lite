      "prompt": "What is the main benefit of depending on Payment rather than Card?",
      "options": [
        {
          "id": "a",
          "text": "Implementations can change behind a stable contract"
        },
        {
          "id": "b",
          "text": "All fees become zero"
        },
        {
          "id": "c",
          "text": "The JVM skips compilation"
        },
        {
          "id": "d",
          "text": "The object becomes static"
        }
      ],
      "correct": [
        "a"
      ],
      "explanation": "Interfaces separate the caller from the implementation.",
      "points": 1
