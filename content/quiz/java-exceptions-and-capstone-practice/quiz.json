      "prompt": "What does try-with-resources close automatically?",
      "options": [
        {
          "id": "a",
          "text": "Every object in scope"
        },
        {
          "id": "b",
          "text": "All static fields"
        },
        {
          "id": "c",
          "text": "Only Strings"
        },
        {
          "id": "d",
          "text": "AutoCloseable resources"
        }
      ],
      "correct": [
        "d"
      ],
      "explanation": "The resource contract defines close().",
