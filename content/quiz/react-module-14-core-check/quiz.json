        {
          "id": "c",
          "text": "Prevents state updates"
        },
        {
          "id": "d",
          "text": "Turns a component into a class"
        }
      ],
      "correct": [
        "a"
      ],
      "explanation": "React.memo memoizes component output based on prop comparison.",
      "points": 1
    },
