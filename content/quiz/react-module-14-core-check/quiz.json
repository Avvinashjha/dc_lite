      "type": "multiple",
      "prompt": "What can trigger a React component render? (Select all that apply.)",
      "options": [
        {
          "id": "a",
          "text": "Its state updates"
        },
        {
          "id": "b",
          "text": "Its parent renders with changed props"
        },
        {
          "id": "c",
          "text": "A context value it reads changes"
        },
        {
          "id": "d",
          "text": "A CSS file exists"
        }
      ],
      "correct": [
        "a",
        "b",
        "c"
      ],
      "explanation": "State, props from parent renders, and context changes are common render triggers.",
      "points": 2
    },
    {
