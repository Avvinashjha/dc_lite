      "type": "single",
      "prompt": "What happens when a hash-map key changes a field used by hashCode?",
      "options": [
        {
          "id": "a",
          "text": "It becomes thread-safe"
        },
        {
          "id": "b",
          "text": "The key is automatically copied"
        },
        {
          "id": "c",
          "text": "Lookup may fail to find its existing entry"
        },
        {
          "id": "d",
          "text": "The map always reindexes it"
        }
      ],
      "correct": [
        "c"
      ],
      "explanation": "The key may no longer match its original bucket.",
      "points": 1
    },
