{
  "name": "dc_lite",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "content:java": "node scripts/build-java-courses.mjs",
    "test:java": "node --experimental-strip-types --test scripts/test-java.mjs",
    "test:java:examples": "node scripts/verify-java-examples.mjs",
    "test:java:api": "node scripts/verify-java-capstone-api.mjs",
    "test:java:container": "node scripts/verify-java-container.mjs",
    "audit:java-output": "node scripts/audit-java-output.mjs",
    "dev": "astro dev",
    "build": "npm run validate:problems && npm run test:school && npm run test:games && npm run test:java && astro build && npm run audit:problem-output && npm run audit:game-output && npm run audit:java-output && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "new-post": "node scripts/add-post.js",
    "validate": "node scripts/validate-posts.js",
    "build:gas": "node scripts/apps-script/build.mjs",
    "test:school": "node --experimental-strip-types --test scripts/test-school.mjs",
    "validate:problems": "node scripts/audit-problems.mjs && node scripts/verify-problem-solutions.mjs && node --test scripts/test-problem-runtime.mjs && node --test scripts/test-problem-format.mjs && node --test scripts/test-problem-discussion.mjs",
    "audit:problem-output": "node scripts/audit-problem-output.mjs",
    "test:games": "node --test scripts/test-games.mjs",
    "audit:game-output": "node scripts/audit-game-output.mjs",
    "build:game-art": "node scripts/build-game-art.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.4",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@nanostores/preact": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.4.2",
    "codemirror": "^6.0.2",
    "firebase": "^12.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "marked-highlight": "^2.2.3",
    "nanostores": "^1.1.0",
    "preact": "^10.28.3",
    "prettier": "3.9.6",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "pagefind": "^1.4.0",
    "sass": "^1.97.3"
  }
}
